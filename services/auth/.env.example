# --- Base de données (base historique `touribook` : conserve les comptes existants) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=touribook

# --- JWT (doit être IDENTIQUE dans tous les services) ---
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Communication inter-services (identique partout) ---
INTERNAL_API_KEY=dev-internal-key-change-me
NOTIFICATION_SERVICE_URL=http://localhost:8006

# --- Tokens e-mail ---
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30

# --- Admin initial (seed) ---
FIRST_ADMIN_EMAIL=admin@touribook.com
FIRST_ADMIN_PASSWORD=ChangeMe@1234
