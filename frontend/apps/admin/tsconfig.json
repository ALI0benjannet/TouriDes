{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@touribook/ui": ["../../packages/ui/src"],
      "@touribook/ui/*": ["../../packages/ui/src/*"],
      "@touribook/api": ["../../packages/api/src"],
      "@touribook/api/*": ["../../packages/api/src/*"],
      "@touribook/auth": ["../../packages/auth/src"],
      "@touribook/auth/*": ["../../packages/auth/src/*"],
      "@touribook/i18n": ["../../packages/i18n/src"],
      "@touribook/i18n/*": ["../../packages/i18n/src/*"]
    },

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "vite.config.ts", "../../packages/*/src"]
}
