{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "ignoreDeprecations": "6.0",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@touribook/ui": [
        "../../packages/ui/src"
      ],
      "@touribook/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@touribook/api": [
        "../../packages/api/src"
      ],
      "@touribook/api/*": [
        "../../packages/api/src/*"
      ],
      "@touribook/auth": [
        "../../packages/auth/src"
      ],
      "@touribook/auth/*": [
        "../../packages/auth/src/*"
      ],
      "@touribook/i18n": [
        "../../packages/i18n/src"
      ],
      "@touribook/i18n/*": [
        "../../packages/i18n/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
